# Copy this file to collector/.env for LOCAL runs only.
# In production, these are set as GitHub Actions secrets/variables — never commit
# a real .env file, and never put a token in this example file.

# A GitHub Personal Access Token (fine-grained) with access to TARGET repos (NOT the hub repo):
#   - Contents: Read and write   (needed to read repo metadata)
#   - Administration: Read-only  (traffic endpoints require push access to the target repo)
# Classic tokens: use the "repo" scope.
# The hub repo itself uses the built-in GITHUB_TOKEN for committing data back.
GH_ANALYTICS_TOKEN=

# The owner/repo of the repository you want to collect data FOR.
# This can be ANY repo you have traffic access to — it does NOT need to be the hub repo.
# e.g. AmirhosseinDehghanazar/my-project   (even if this repo is "analytics-hub")
# For multi-repo local runs: run the collector multiple times with different values:
#   GH_ANALYTICS_REPO=owner/repo-a npm run collect
#   GH_ANALYTICS_REPO=owner/repo-b npm run collect
GH_ANALYTICS_REPO=

# Override where the dataset is written. Defaults to ../data/history.json
# For multi-repo local dev, set this to match the new layout:
#   HISTORY_PATH=../data/owner-repo/history.json
# HISTORY_PATH=../data/history.json
